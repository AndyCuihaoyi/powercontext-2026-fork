GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8099

# seekdb 1.4.x (MySQL protocol). 2886 matches deploy/source-deploy.md; change to 2881 if you use the official Docker compose.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2886
SEEKDB_USER=root
SEEKDB_PASSWORD=change-me
SEEKDB_DATABASE=pawnshop

POWERCONTEXT_URL=http://127.0.0.1:17429
POWERCONTEXT_TOKEN=

# mock: deterministic offline replies, no API key required.
# openai: forward to any OpenAI-compatible chat completions endpoint.
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=120
REQUEST_TIMEOUT=15

# Dify service API used by the web page (gateway keeps the key server-side).
# Leave DIFY_API_KEY empty to disable the /api/run proxy; the workflow's own
# LLM node still calls this gateway's /api/llm with LLM_MODE above.
DIFY_BASE_URL=http://127.0.0.1:5001
DIFY_API_KEY=
DIFY_TIMEOUT=180
