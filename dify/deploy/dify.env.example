# Values verified against Dify 1.18.0 source deployment on seekdb 1.4.0.
# Copy into api/.env and fill in the secrets that are masked here.

# --- seekdb as the Dify metadata database ---
DB_TYPE=seekdb
DB_HOST=127.0.0.1
DB_PORT=2886
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=dify

# --- seekdb as the vector store ---
VECTOR_STORE=seekdb

# --- required cache / celery broker ---
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=change-me
REDIS_DB=0
CELERY_BROKER_URL=redis://:change-me@127.0.0.1:56379/1

# --- this app uses no code/template nodes, so the sandbox/plugin daemon can stay down ---
# CODE_EXECUTION_ENDPOINT=http://127.0.0.1:8194

SECRET_KEY=change-me
INIT_PASSWORD=change-me
