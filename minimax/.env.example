# MiniMax · SDD 上下文管理模块：配置样例（全部为占位值，切勿把真实密钥提交到仓库）
# 用法：cp .env.example .env && 编辑 .env && set -a && source .env && set +a

# —— MiniMax（必做项 2 需要真实调用；只从环境变量读取，代码里不写死）——
MINIMAX_API_KEY=your-minimax-api-key-placeholder
# 国内站密钥用 https://api.minimaxi.com/v1，国际站密钥用 https://api.minimax.io/v1
# 用错站点会返回 401「invalid api key (2049)」，与密钥本身无关
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_TIMEOUT=180
# 推理模型的思考过程计入 completion_tokens；低于约 8000 会出现 finish_reason=length 且正文为空
MINIMAX_MAX_TOKENS=16000
MINIMAX_TEMPERATURE=0.1

# —— seekdb（必做项 4：存资料 + 全文索引 + 真查询）——
SDDCTX_SEEKDB_HOST=127.0.0.1
SDDCTX_SEEKDB_PORT=2893
SDDCTX_SEEKDB_USER=root
SDDCTX_SEEKDB_PASSWORD=
SDDCTX_SEEKDB_DATABASE=sdd_eco
SDDCTX_FTS_PARSER=ik

# —— PowerContext（必做项 5：任务状态写入与跨进程复用）——
# 内嵌 runtime 的 SQLite 文件，默认 minimax/runtime/powercontext/state.db
SDDCTX_PC_DB=
SDDCTX_PC_PREFIX=sddctx

# —— 路径与检索上限（一般不用改）——
SDDCTX_ROOT=
SDDCTX_DEMO_ROOT=
SDDCTX_RUNTIME_DIR=
SDDCTX_EVIDENCE_DIR=
SDDCTX_LIMIT_SPEC=8
SDDCTX_LIMIT_CODE=8
SDDCTX_LIMIT_TEST=8
